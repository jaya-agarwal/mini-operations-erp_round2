# --- Database ---
# For production / submission: use a Neon Postgres connection string.
# Create a free project at https://neon.tech, then copy the pooled connection
# string here. Must include sslmode=require.
# Example: postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/minierp_dev"

# For local development without Neon, point at a local Postgres instead:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/minierp_dev"

# --- Auth ---
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="8h"

# --- Server ---
PORT=4000
NODE_ENV="development"

# --- Feature flags ---
# Turn on to enable Live-Verification "Change 4": restrict users to only
# their assigned location. Off by default because the base spec doesn't
# require it — flip to "true" and restart if this is the change you get.
ENFORCE_LOCATION_RESTRICTION="false"
